# Host folder where generated IRM PDFs are written.
# The Windows launcher supplies the current user's Downloads folder automatically.
PREDIOAI_DOWNLOADS=./downloads

# Exact frontend origins allowed to call the local bridge. Add the commercial
# HTTPS frontend origin here after its domain has been chosen.
IRM_ALLOWED_ORIGINS=https://jayjayanton.github.io,http://localhost:5173,http://127.0.0.1:5173
