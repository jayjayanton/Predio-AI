# Local API. Hosted builds need the deployed API's exact HTTPS origin.
# VITE_* values are public and are embedded in the frontend during its build.
VITE_API_URL=http://localhost:8000

# Leave unset for GitHub Pages (/Predio-AI/) and local development (/).
# Set to / for a frontend served at a Render or custom-domain root.
# VITE_BASE_PATH=/
